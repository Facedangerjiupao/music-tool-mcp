{
  "identifier": "facedangerjiupao-music-tool-mcp",
  "name": "Music Tool MCP",
  "version": "1.3.0",
  "description": "URL/local audio or video to retained media and full-track editing timestamps. MCP and CLI workflow fork of Audio Sonic MCP; optional Beat This! beats and downbeats.",
  "author": "Facedangerjiupao",
  "authorUrl": "https://github.com/Facedangerjiupao",
  "homepage": "https://github.com/Facedangerjiupao/music-tool-mcp",
  "icon": "🎵",
  "tags": [
    "audio",
    "video",
    "music",
    "beat-tracking",
    "downbeats",
    "workflow",
    "mcp",
    "local-first"
  ],
  "tools": [
    {
      "name": "prepare_media",
      "description": "Submit a URL or local audio/video for extraction or full-track rhythm timestamps. Returns job_id immediately; poll get_job_status until success or error.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "extract",
              "rhythm",
              "full"
            ],
            "default": "rhythm"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "audio",
              "video"
            ],
            "default": "audio"
          },
          "beat_engine": {
            "type": "string",
            "enum": [
              "librosa",
              "beat-this",
              "all-in-one"
            ],
            "default": "librosa"
          },
          "fps": {
            "type": "number",
            "default": 30
          },
          "keep_media": {
            "type": "boolean",
            "default": true
          },
          "separate": {
            "type": "boolean",
            "default": false
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "source"
        ]
      }
    },
    {
      "name": "get_sonic_signature",
      "description": "Submits a YouTube URL for sonic analysis and returns immediately.\nThe pipeline runs in the background — poll get_job_status(job_id) for results.\nTypical processing: 20-30s on GPU, ~6-8 min on CPU (Demucs separation dominates).\n\nArgs:\n    url: YouTube URL of the track to analyze.\n    job_id: Optional custom job ID. Auto-generated if omitted.",
      "inputSchema": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "job_id": {
            "default": null,
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "get_sonic_signatureArguments",
        "type": "object"
      }
    },
    {
      "name": "get_job_status",
      "description": "Read a submitted workflow or legacy job by job_id. Completed results persist across restarts.",
      "inputSchema": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "get_job_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "list_jobs",
      "description": "Lists all completed and in-progress analysis jobs.",
      "inputSchema": {
        "properties": {},
        "title": "list_jobsArguments",
        "type": "object"
      }
    },
    {
      "name": "check_health",
      "description": "Verification tool for server dependencies.",
      "inputSchema": {
        "properties": {},
        "title": "check_healthArguments",
        "type": "object"
      }
    }
  ]
}
